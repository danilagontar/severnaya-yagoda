# Режим LLM: rules (без сети) | gigachat
LLM_MODE=rules

# GigaChat API — ключ авторизации (Base64 от Client ID:Client Secret) из личного кабинета.
# Только на сервере: не добавлять префикс VITE_, иначе ключ попадёт в браузер.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max

# Корневой сертификат НУЦ Минцифры (нужен Node для TLS к GigaChat)
NODE_EXTRA_CA_CERTS=./certs/russian_trusted_root_ca.pem
